{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/trvny/.ai/main/schema/style-profile.schema.json",
  "title": "Portable AI Style Profile",
  "description": "Communication and collaboration profile. Tool permissions, credentials, model choice, routing, and execution policy remain outside this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "locale", "personality", "collaboration"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 80
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {
          "type": "string",
          "enum": ["default", "professional", "friendly", "honest", "whimsical", "concise", "cynical"]
        },
        "intensity": {"$ref": "#/$defs/intensity"},
        "modifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "honest": {"$ref": "#/$defs/intensity"},
            "warm": {"$ref": "#/$defs/intensity"},
            "enthusiastic": {"$ref": "#/$defs/intensity"},
            "concise": {"$ref": "#/$defs/intensity"},
            "technical": {"$ref": "#/$defs/intensity"},
            "educational": {"$ref": "#/$defs/intensity"},
            "critical": {"$ref": "#/$defs/intensity"},
            "headingsAndLists": {"$ref": "#/$defs/intensity"},
            "emoji": {"$ref": "#/$defs/intensity"},
            "quickReplies": {"$ref": "#/$defs/intensity"},
            "whimsical": {"$ref": "#/$defs/intensity"},
            "cynical": {"$ref": "#/$defs/intensity"}
          }
        },
        "adaptation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "followUserRegister": {"type": "boolean", "default": true},
            "preserveRequestedArtifactStyle": {"type": "boolean", "default": true},
            "reduceHumorInSeriousContexts": {"type": "boolean", "default": true},
            "mirrorLanguage": {"type": "boolean", "default": true},
            "allowCasualProfanity": {"type": "boolean", "default": false}
          }
        }
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preamble", "initiative", "verification"],
      "properties": {
        "preamble": {"type": "string", "enum": ["off", "multiStepOnly", "always"]},
        "initiative": {"type": "string", "enum": ["conservative", "balanced", "proactive"]},
        "verification": {"type": "string", "enum": ["light", "normal", "strict"]},
        "questionPolicy": {"type": "string", "enum": ["blockingOnly", "materialAmbiguity", "earlyAlignment"]},
        "assumptionPolicy": {"type": "string", "enum": ["cautious", "balanced", "decisive"]},
        "answerFirst": {"type": "boolean"},
        "plainChatIsDefault": {"type": "boolean"},
        "respectExplicitTurnInstructions": {"type": "boolean"},
        "avoidRoutinePraise": {"type": "boolean"},
        "avoidRoutineFollowUpOffer": {"type": "boolean"},
        "announceOnlyMaterialActions": {"type": "boolean"},
        "reportPartialFailures": {"type": "boolean"},
        "preferResultOverProcess": {"type": "boolean"}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distinguishRawFromSynthesis": {"type": "boolean"},
        "treatMemoryAsFallible": {"type": "boolean"},
        "surfaceSourceConflicts": {"type": "boolean"},
        "preferMaintainedSynthesisForOrientation": {"type": "boolean"},
        "requireTraceableClaims": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultFormat": {"type": "string", "enum": ["prose", "compact", "structured", "markdown"]},
        "maxHeadingDepth": {"type": "integer", "minimum": 1, "maximum": 6},
        "preferShortParagraphs": {"type": "boolean"},
        "tables": {"type": "string", "enum": ["avoid", "whenUseful", "prefer"]},
        "codeExamples": {"type": "string", "enum": ["minimal", "runnable", "explanatory"]},
        "citations": {"type": "string", "enum": ["platformDefault", "whenAvailable", "requiredForExternalFacts"]}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]+$"},
      "additionalProperties": true
    }
  },
  "$defs": {
    "intensity": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 3
    }
  }
}
